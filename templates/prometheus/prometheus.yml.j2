# my global config
global:
  scrape_interval: 15s # Set the scrape interval to every 15 seconds. Default is every 1 minute.
  evaluation_interval: 15s # Evaluate rules every 15 seconds. The default is every 1 minute.
  # scrape_timeout is set to the global default (10s).

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
          # - alertmanager:9093


# Load rules once and periodically evaluate them according to the global 'evaluation_interval'.
rule_files:
  # - "first_rules.yml"
  # - "second_rules.yml"
scrape_configs:
  - job_name: 'portalstone'
    scheme: http
    scrape_interval: 1m
    scrape_timeout: 10s
    metrics_path: /metrics
    static_configs:
      - targets: ["10.1.1.1:9100"]
        labels:
          app: "portalstone"
  - job_name: 'traefik'
    scheme: http
    scrape_interval: 1m
    scrape_timeout: 10s
    metrics_path: /metrics
    static_configs:
      - targets: ["traefik.rk1.mcharryville.space:8082"]
        labels:
          app: "traefik"
  - job_name: 'syncthing'
    scheme: http
    scrape_interval: 10s
    scrape_timeout: 5s
    metrics_path: /metrics
    static_configs:
      - targets: ["10.1.1.5:8384","10.1.1.7:20910"]
        labels:
          app: "syncthing"
  - job_name: "prometheus"
    # metrics_path defaults to '/metrics'
    # scheme defaults to 'http'.
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          app: "prometheus"
  - job_name: 'pve'
    static_configs:
      - targets:
        - 10.1.1.250  # Proxmox VE node.
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 10.1.1.61:9221  # PVE exporter.
        
  - job_name: 'rk1-cluster'
    scheme: http
    scrape_interval: 10s
    scrape_timeout: 5s
    metrics_path: /metrics
    static_configs:
      - targets: ["10.1.1.31:9100","10.1.1.32:9100","10.1.1.33:9100","10.1.1.34:9100"]
        labels:
          sbc: "true"

  # Container metrics. cadvisor runs as a global Swarm service on the
  # traefik_proxy overlay network (see tasks/prometheus.yml), so discover its
  # tasks through the Docker socket and scrape each one on port 8080.
  - job_name: 'cadvisor'
    scheme: http
    scrape_interval: 10s
    scrape_timeout: 5s
    metrics_path: /metrics
    dockerswarm_sd_configs:
      - host: unix:///var/run/docker.sock
        role: tasks
        port: 8080
    relabel_configs:
      - source_labels: [__meta_dockerswarm_service_name]
        regex: cadvisor
        action: keep
      - source_labels: [__meta_dockerswarm_task_desired_state]
        regex: running
        action: keep
      - source_labels: [__meta_dockerswarm_node_hostname]
        target_label: host

  # Drive health. smartctl-exporter runs as a standalone privileged container
  # on each node (not a Swarm service), so scrape the node IPs directly. Its
  # default collection interval is 60s.
  - job_name: 'smartctl'
    scheme: http
    scrape_interval: 60s
    scrape_timeout: 30s
    metrics_path: /metrics
    static_configs:
      - targets: ["10.1.1.31:9633"]
        labels:
          host: "rk1-cluster01"
      - targets: ["10.1.1.32:9633"]
        labels:
          host: "rk1-cluster02"
      - targets: ["10.1.1.33:9633"]
        labels:
          host: "rk1-cluster03"
      - targets: ["10.1.1.34:9633"]
        labels:
          host: "rk1-cluster04"
